# ============================================
# Database
# ============================================
# Connection string usata dall'app (Transaction Pooler, porta 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DBNAME?pgbouncer=true&connection_limit=1"
# Connection string usata solo dalle migrazioni Prisma (Session Pooler, porta 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ============================================
# Admin
# ============================================
# Hash SHA-256 (hex) della password admin. Genera con:
# printf %s "la-tua-password" | shasum -a 256 | awk '{print $1}'
ADMIN_PASSWORD_HASH="hash_esadecimale_di_64_caratteri"

# ============================================
# Email (Resend)
# ============================================cat .env
# API key di Resend (https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Mittente delle email (deve essere un dominio verificato su Resend)
RESEND_FROM="Ticket Manager <noreply@example.com>"

# ============================================
# App
# ============================================
# URL pubblica dell'app, usata nei link delle email
APP_URL="https://your-domain.example.com"
# Fallback client-side per l'URL pubblico
NEXT_PUBLIC_APP_URL="https://your-domain.example.com"
# Ore lavorative per giorno (usato dallo scheduler)
WORK_HOURS_PER_DAY="8"

# ============================================
# Cloudflare Turnstile (anti-bot sul form pubblico)
# ============================================
# Chiave segreta (server-side): https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY="0x00000000000000000000000000000000"
# Chiave pubblica (client-side, esposta al browser)
TURNSTILE_SITE_KEY="0x00000000000000000000000000000000"
